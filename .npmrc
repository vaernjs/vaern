# Repo-level npm config. Safe to commit — contains NO secrets.
#
# The ${VAR} syntax is npm's own environment substitution: the token never
# lives in this file. In CI it comes from secrets.NPM_TOKEN.

registry=https://registry.npmjs.org/

# Local development: run `npm login` once. That writes the token to your
# ~/.npmrc (NOT this file). Do not paste a token into a committed .npmrc.
#
# CI: set NPM_TOKEN and uncomment the next line (or leave it — npm ignores an
# unset variable substitution by failing auth, which is what you want).
//registry.npmjs.org/:_authToken=${NPM_TOKEN}

# Pin exact versions in optionalDependencies. A caret here silently breaks the
# lockstep guarantee between the main package and its platform binaries.
save-exact=true

# Deterministic, quiet installs in CI
fund=false
audit=false

# Do NOT put `provenance=true` here. Provenance requires an OIDC identity, which
# only exists inside GitHub Actions; setting it locally makes `npm publish` fail.
# It is enabled per-package in publishConfig instead.
