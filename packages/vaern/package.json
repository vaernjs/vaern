{
  "name": "@vaernjs/vaern",
  "version": "0.0.5",
  "description": "Vaern — an agent-native JavaScript & TypeScript runtime. Runs TypeScript directly, with fetch and an HTTP server built in.",
  "keywords": [
    "runtime",
    "javascript",
    "typescript",
    "agent",
    "agents",
    "cli",
    "vaern",
    "devlogix"
  ],
  "license": "MIT",
  "author": {
    "name": "DEVLOGIX TECHNOLOGY (PRIVATE) LIMITED",
    "url": "https://devlogix.com.pk"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaernjs/vaern.git",
    "directory": "packages/vaern"
  },
  "bugs": {
    "url": "https://github.com/vaernjs/vaern/issues"
  },
  "type": "commonjs",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "vaern": "bin/vaern.cjs"
  },
  "files": [
    "bin/",
    "index.js",
    "index.d.ts",
    "scripts/postinstall.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.cjs",
    "prepublishOnly": "node ../../scripts/check-publish.mjs"
  },
  "optionalDependencies": {
    "@vaernjs/vaern-linux-x64": "0.0.5",
    "@vaernjs/vaern-linux-arm64": "0.0.5",
    "@vaernjs/vaern-darwin-arm64": "0.0.5",
    "@vaernjs/vaern-darwin-x64": "0.0.5",
    "@vaernjs/vaern-win32-x64": "0.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "homepage": "https://vaernjs.tech"
}
